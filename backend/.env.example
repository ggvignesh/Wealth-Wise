# WealthWise Backend Environment Variables
# Copy this file to .env and update values

SECRET_KEY=wealthwise-super-secret-key-change-in-production
JWT_SECRET_KEY=wealthwise-jwt-secret-change-in-production

# MySQL Database URL
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost/wealthwise_db

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=True
